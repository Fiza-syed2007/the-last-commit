generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Registration {
  id          String   @id @default(cuid())

  fullName    String
  email       String
  college     String

  teamName    String
  teamSize    Int
  teamMembers String?

  projectName String
  track       String
  description String

  status      String   @default("PENDING")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}